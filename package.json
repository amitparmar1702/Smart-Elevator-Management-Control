{
  "name": "smart-elevator-platform",
  "version": "1.0.0",
  "private": true,
  "description": "ElevateOS - Enterprise Smart Elevator Management & Control Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
