# ==============================================================================
# ElevateOS - Smart Elevator Management & Control Platform Environment Config
# ==============================================================================

# ------------------------------------------------------------------------------
# GLOBAL / ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
API_PORT=4000
IOT_PORT=5000
EMQX_PORT=1883
EMQX_WS_PORT=8083

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL + TimescaleDB)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:elevateos_secret@localhost:5432/elevateos_db?schema=public"
TIMESCALEDB_URL="postgresql://postgres:elevateos_secret@localhost:5432/elevateos_telemetry"

# ------------------------------------------------------------------------------
# REDIS (Cache, Session, BullMQ Queue)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-this-to-a-secure-random-key-in-production-min32chars"
JWT_REFRESH_SECRET="change-this-refresh-key-in-production-min32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
SESSION_SECRET="super-secure-session-encryption-secret"
MFA_ISSUER_NAME="ElevateOS"
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="ElevateOS"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
NEXT_PUBLIC_ENABLE_SIMULATOR_CONTROLS=true

# ------------------------------------------------------------------------------
# IOT & MQTT (EMQX Broker)
# ------------------------------------------------------------------------------
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_CLIENT_ID="elevateos_iot_gateway_core"
MQTT_USERNAME="elevateos_service"
MQTT_PASSWORD="elevateos_mqtt_password"
MQTT_USE_TLS=false
MQTT_CA_CERT_PATH=""
MQTT_CLIENT_CERT_PATH=""
MQTT_CLIENT_KEY_PATH=""

# ------------------------------------------------------------------------------
# SIMULATOR CONFIGURATION
# ------------------------------------------------------------------------------
SIMULATOR_ENABLED=true
SIMULATOR_TICK_RATE_MS=1000
SIMULATOR_AUTORUN=true

# ------------------------------------------------------------------------------
# S3 OBJECT STORAGE (Documents, Inspection Photos, Reports)
# ------------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="elevateos-assets"
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# NOTIFICATIONS (SMTP / Email, SMS, WhatsApp)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@elevateos.local"
SMTP_PASS="smtp_password"
SMTP_FROM="ElevateOS Notifications <no-reply@elevateos.local>"
SMS_GATEWAY_API_KEY=""
WHATSAPP_API_TOKEN=""

# ------------------------------------------------------------------------------
# OBSERVABILITY & MONITORING
# ------------------------------------------------------------------------------
SENTRY_DSN=""
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL="debug"

